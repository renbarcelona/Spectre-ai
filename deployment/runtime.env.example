# Copy to .env.runtime only ON YOUR TRUSTED DEPLOYMENT HOST; chmod 600.
# Never commit or include the populated file in source exports.
NODE_ENV=production
PORT=8080
STATIC_DIR=/app/artifacts/sentinel/dist/public
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_SERVER.postgres.database.azure.com:5432/spectre
SPECTRE_SETUP_CODE=REPLACE_WITH_RANDOM_SETUP_CODE
AI_INTEGRATIONS_OPENAI_BASE_URL=https://REPLACE_RESOURCE.openai.azure.com/openai/v1
AI_INTEGRATIONS_OPENAI_API_KEY=REPLACE_WITH_AZURE_OPENAI_KEY
AI_MODEL=REPLACE_AZURE_MODEL_DEPLOYMENT_NAME
